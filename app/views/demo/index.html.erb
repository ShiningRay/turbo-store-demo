<div class="min-h-screen bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950" x-data>
  <!-- 顶部导航 -->
  <header class="border-b border-slate-800/60 backdrop-blur-sm bg-slate-950/80 sticky top-0 z-10">
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-sm">TS</div>
        <div>
          <h1 class="text-lg font-semibold text-white">Turbo Store</h1>
          <p class="text-xs text-slate-400">Document-level reactive state</p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Live
        </span>
      </div>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-6 py-10">
    <!-- Hero -->
    <div class="mb-10">
      <h2 class="text-4xl font-bold tracking-tight text-white mb-3">Turbo Store Demo</h2>
      <p class="text-lg text-slate-400 max-w-2xl">Alpine.js document-level store + Turbo Stream 同步示例。服务器推送 HTML 的同时更新全局状态，所有依赖自动刷新。</p>
    </div>

    <!-- 状态卡片 -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">
      <div class="group relative overflow-hidden rounded-2xl bg-slate-900/60 border border-slate-800 p-6 hover:border-indigo-500/50 transition-colors">
        <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
        <div class="relative">
          <div class="flex items-center gap-2 mb-4">
            <div class="w-8 h-8 rounded-lg bg-indigo-500/20 flex items-center justify-center">
              <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            </div>
            <h3 class="text-sm font-medium text-slate-400 uppercase tracking-wider">Current User</h3>
          </div>
          <p class="text-2xl font-bold text-white" x-text="$store.app.current_user.name"></p>
          <p class="mt-1 text-sm text-slate-400 capitalize" x-text="$store.app.current_user.role"></p>
        </div>
      </div>

      <div class="group relative overflow-hidden rounded-2xl bg-slate-900/60 border border-slate-800 p-6 hover:border-emerald-500/50 transition-colors">
        <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
        <div class="relative">
          <div class="flex items-center gap-2 mb-4">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/20 flex items-center justify-center">
              <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            </div>
            <h3 class="text-sm font-medium text-slate-400 uppercase tracking-wider">Cart Count</h3>
          </div>
          <p class="text-2xl font-bold text-white" x-text="$store.app.cart.count"></p>
          <p class="mt-1 text-sm text-slate-400">items in cart</p>
        </div>
      </div>

      <div class="group relative overflow-hidden rounded-2xl bg-slate-900/60 border border-slate-800 p-6 hover:border-amber-500/50 transition-colors">
        <div class="absolute inset-0 bg-gradient-to-br from-amber-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
        <div class="relative">
          <div class="flex items-center gap-2 mb-4">
            <div class="w-8 h-8 rounded-lg bg-amber-500/20 flex items-center justify-center">
              <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
            </div>
            <h3 class="text-sm font-medium text-slate-400 uppercase tracking-wider">Theme</h3>
          </div>
          <p class="text-2xl font-bold text-white capitalize" x-text="$store.app.theme"></p>
          <p class="mt-1 text-sm text-slate-400">color scheme</p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mb-8">
      <!-- 条件渲染 -->
      <div class="rounded-2xl bg-slate-900/60 border border-slate-800 p-6">
        <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Conditional Rendering
        </h3>
        <div class="space-y-3">
          <template x-if="$store.app.current_user.role === 'member'">
            <div class="flex items-center gap-3 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20">
              <div class="w-8 h-8 rounded-full bg-emerald-500/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              </div>
              <div>
                <p class="text-emerald-300 font-medium">Welcome back, member!</p>
                <p class="text-sm text-emerald-400/70">You have full access to all features.</p>
              </div>
            </div>
          </template>
          <template x-if="$store.app.current_user.role !== 'member'">
            <div class="flex items-center gap-3 p-4 rounded-xl bg-amber-500/10 border border-amber-500/20">
              <div class="w-8 h-8 rounded-full bg-amber-500/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
              </div>
              <div>
                <p class="text-amber-300 font-medium">You are browsing as a guest</p>
                <p class="text-sm text-amber-400/70">Sign in to unlock member features.</p>
              </div>
            </div>
          </template>
        </div>
      </div>

      <!-- 通知列表 -->
      <div class="rounded-2xl bg-slate-900/60 border border-slate-800 p-6">
        <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
          Notifications
          <span class="ml-auto text-xs font-normal text-slate-500" x-text="$store.app.notifications.length + ' items'"></span>
        </h3>
        <div class="space-y-2 max-h-48 overflow-y-auto pr-2">
          <template x-for="(note, index) in $store.app.notifications" :key="index">
            <div class="flex items-start gap-3 p-3 rounded-lg bg-slate-800/50 border border-slate-700/50">
              <div class="w-2 h-2 rounded-full bg-indigo-400 mt-2 flex-shrink-0"></div>
              <p class="text-sm text-slate-300" x-text="note"></p>
            </div>
          </template>
          <div x-show="$store.app.notifications.length === 0" class="text-center py-8 text-slate-500">
            <svg class="w-10 h-10 mx-auto mb-3 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/></svg>
            <p class="text-sm">No notifications yet</p>
          </div>
        </div>
      </div>
    </div>

    <!-- 服务器更新 -->
    <div class="rounded-2xl bg-slate-900/60 border border-slate-800 p-6 mb-8">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div>
          <h3 class="text-lg font-semibold text-white mb-2 flex items-center gap-2">
            <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>
            Server-Driven Updates
          </h3>
          <p class="text-sm text-slate-400">Turbo Stream 返回 HTML 片段并同步更新全局 store</p>
        </div>
        <div class="flex flex-col items-start md:items-end gap-3">
          <div id="server-time" class="px-4 py-2 rounded-lg bg-slate-800/80 border border-slate-700">
            <span class="font-mono text-sm text-cyan-300">Server time: not loaded</span>
          </div>
          <%= link_to "Fetch Update from Server", demo_update_store_path, data: { turbo_method: :post }, class: "inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-indigo-600 to-purple-600 text-white text-sm font-medium shadow-lg shadow-indigo-500/25 hover:shadow-indigo-500/40 hover:scale-[1.02] active:scale-[0.98] transition-all" %>
        </div>
      </div>
    </div>

    <!-- 本地操作 -->
    <div class="rounded-2xl bg-slate-900/60 border border-slate-800 p-6">
      <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        Local Store Mutation
      </h3>
      <div class="flex flex-wrap gap-3">
        <button @click="$store.app.theme = $store.app.theme === 'light' ? 'dark' : 'light'"
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-sm font-medium text-slate-200 hover:bg-slate-700 hover:border-slate-600 active:scale-[0.98] transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
          Toggle Theme
        </button>
        <button @click="$store.app.cart.count++"
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-sm font-medium text-slate-200 hover:bg-slate-700 hover:border-slate-600 active:scale-[0.98] transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
          Increment Cart
        </button>
        <button @click="$store.app.current_user.name = 'Guest'; $store.app.current_user.role = 'visitor'; $store.app.cart.count = 0; $store.app.notifications = []"
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-sm font-medium text-slate-200 hover:bg-slate-700 hover:border-slate-600 active:scale-[0.98] transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          Reset Store
        </button>
      </div>
    </div>

    <!-- 页脚 -->
    <footer class="mt-12 pt-6 border-t border-slate-800/60 text-center text-sm text-slate-500">
      <p>Turbo Store Demo — Rails 8 + Alpine.js + Turbo Stream</p>
    </footer>
  </main>
</div>
